# Copy to .env.local for local development, and set the same three values in
# Vercel under Project Settings → Environment Variables.
#
# Never commit real values. .env.local is already gitignored.

# Resend API key — https://resend.com → API Keys
RESEND_API_KEY=

# Where enquiries land. Comma-separate for more than one recipient.
INQUIRY_TO_EMAIL=events@example.com

# The "from" address. Must be on a domain you have verified in Resend.
# Until a domain is verified, Resend's onboarding@resend.dev works for testing.
INQUIRY_FROM_EMAIL=enquiries@example.com
